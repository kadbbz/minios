{
  "name": "minios",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MiniOS core runtime and management CLI",
  "scripts": {
    "compose:init:standalone": "node scripts/init-compose-data.mjs ./data standalone",
    "compose:init:gateway": "node scripts/init-compose-data.mjs ./data gateway",
    "compose:init:node": "node scripts/init-compose-data.mjs ./data node",
    "compose:standalone:up": "node scripts/compose-up.mjs --compose-file docker-compose.standalone.yml --mode standalone",
    "compose:standalone:up:fg": "node scripts/compose-up.mjs --compose-file docker-compose.standalone.yml --mode standalone --foreground",
    "compose:gateway:up": "node scripts/compose-up.mjs --compose-file docker-compose.gateway.yml --mode gateway",
    "compose:gateway:up:fg": "node scripts/compose-up.mjs --compose-file docker-compose.gateway.yml --mode gateway --foreground",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "check": "tsc -p tsconfig.json --noEmit",
    "start:gateway": "node dist/gateway/server.js",
    "start:gateway:node": "node scripts/start-node-gateway.mjs",
    "test:fast": "python3 test/fast/run_smoke.py",
    "test:docker:fast": "python3 test/docker/compose_image_fast_test.py --image minios-gateway:test-current",
    "test:docker:full": "python3 test/docker/compose_image_full_test.py --image minios-gateway:test-current"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
